              "EXCESSIVE_LEVERAGE",
              "STRUCTURAL_PRICE_WAR",
              "SCALE_DISADVANTAGE"
            ]
          },
          "fcf_margin": { "type": "number" },
          "has_pricing_power": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "required": ["ticker"]
      }
    }
  },
  {
